---
shader:
  name: Skybox
  settings:
    depthStencil:
      depthFunction: LEqual
      depthTest: false
  subShader:
      priority: 100
      properties:
        - name: skybox
          type: Cubemap
          value: "White"
      stages:
        - stageType: Vertex
          functionName: VS
        - stageType: Fragment
          functionName: PS
      code: |
        #include "Camera.hlsli"

        struct VertexIn
        {
            float3 PosL  : a_Position;
            float4 Color : a_Color;
            float3 Normal  : a_Normal;
            float3 Tangent  : a_Tangent;
            float2 TexCoord  : a_TexCoord;
        };

        struct VertexOut
        {
            float4 PosH  : SV_POSITION;
            float2 TexC    : TEXCOORD;
            float3 TexC2    : TEXCOORD2;
        };

        TextureCube  skybox : register(t1);

        SamplerState gsamPointWrap : register(s0);

        VertexOut VS(VertexIn vin)
        {
            VertexOut vOut;
            float4 pos = VWolfTransformWorldSpaceToHClip(float4(vin.PosL, 1.0));

            // Having z equal w will always result in a depth of 1.0f
            vOut.PosH = float4(pos.x, pos.y, pos.w, pos.w);
            // We want to flip the z axis due to the different coordinate systems (left hand vs right hand)
            vOut.TexC2 = float3(vin.PosL.x, vin.PosL.y, -vin.PosL.z);
            vOut.TexC = vin.TexCoord;
            
            return vOut;
        }

        float4 PS(VertexOut pin): SV_Target{
            const float PI = 3.14159265359;
            
            float longitude = (pin.TexC.x * 2.0 - 1.0) * PI;
            float latitude = (pin.TexC.y * 2.0 - 1.0) * (PI / 2.0);

            float3 direction;
            direction.x = cos(latitude) * sin(longitude);
            direction.y = sin(latitude);
            direction.z = cos(latitude) * cos(longitude);
            direction = normalize(direction);
            
            float4 sampleTexture = skybox.Sample(gsamPointWrap, normalize(pin.TexC2));
            // float4 sampleTexture = skybox.Sample(gsamPointWrap, -direction);
            return sampleTexture;
        }
